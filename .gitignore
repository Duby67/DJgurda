# Локальные секреты и окружение
.env
test/handlers/YandexMusic/.env.yandex_music_tests
*_cookies.txt
deploy/cookies/*
!deploy/cookies/README.md
!deploy/cookies/AGENTS.md
deploy/sync_cookies.env

# Виртуальные окружения Python
.venv/
venv/
env/

# Кеши и артефакты Python/тестов
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Сборка и упаковка Python
build/
dist/
*.egg-info/
pip-wheel-metadata/

# IDE и редакторы
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
*.iml

# Локальные логи и временные файлы
*.log
*.out
*.err
*.pid
*.pid.lock
*.tmp
*.temp

# Временные файлы операционных систем
.DS_Store
Thumbs.db
Desktop.ini

# Локальные runtime-артефакты проекта
src/data/db/*
!src/data/db/README.md
!src/data/db/AGENTS.md
src/data/runtime/*
!src/data/runtime/README.md
!src/data/runtime/AGENTS.md
src/data/cookies/*
!src/data/cookies/README.md
!src/data/cookies/AGENTS.md

runs/*
!runs/README.md
!runs/AGENTS.md
