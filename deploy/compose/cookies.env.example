# Файл используется только на сервере (не коммитится в git).
# Скопируйте как .env.cookies и заполните под ваш сервер.

COOKIES_BROWSER=firefox
COOKIES_BROWSER_PROFILE=/cookies_extractor/firefox_profile
COOKIES_DOMAIN=youtube.com
COOKIES_OUTPUT_FILE=www.youtube.com_cookies.txt
COOKIES_MIN_COOKIES=1
