{
  "version": 1,
  "description": "Machine-readable routing map for agent-first task classification and context loading.",
  "base_context_pack": {
    "agents": [
      "AGENTS.md"
    ],
    "docs": [
      "ARCHITECTURE.md",
      "docs/RELIABILITY.md",
      "docs/SECURITY.md"
    ],
    "notes": [
      "README.md is human-facing and not a source of truth for agents.",
      "Do not use untracked legacy or archive materials as a primary source of truth without an explicit user request.",
      "If the task touches scripts/agents/, approvals, sandbox, MCP/CLI or run artifacts, move into the swarm contour docs early."
    ]
  },
  "task_types": [
    {
      "id": "swarm_runtime_orchestration_change",
      "label": "Swarm Runtime Orchestration Change",
      "read_agents": [
        "AGENTS.md",
        "scripts/AGENTS.md"
      ],
      "read_docs": [
        "ARCHITECTURE.md",
        "docs/swarm-runtime.md",
        "docs/swarm-usage.md",
        "docs/commit-policy.md"
      ],
      "read_code": [
        "scripts/agents/mcp/",
        "scripts/agents/lifecycle/",
        "scripts/agents/executor.py"
      ],
      "check_tests": [
        "test/scripts/test_swarm_mcp_smoke.py",
        "test/scripts/test_swarm_executor_smoke.py"
      ],
      "notes": [
        "Keep dispatcher, supervisor, lifecycle transitions and approval wrappers aligned."
      ]
    },
    {
      "id": "swarm_sandbox_or_remote_execution_change",
      "label": "Swarm Sandbox Or Remote Execution Change",
      "read_agents": [
        "AGENTS.md",
        "scripts/AGENTS.md",
        "test/docker/AGENTS.md"
      ],
      "read_docs": [
        "docs/swarm-runtime.md",
        "docs/sandbox-execution.md",
        "docs/testing-policy.md"
      ],
      "read_code": [
        "scripts/agents/sandbox_adapters.py",
        ".github/workflows/swarm-sandbox.yml",
        "test/docker/swarm-test/"
      ],
      "check_tests": [
        "test/scripts/test_swarm_sandbox_adapters.py"
      ],
      "notes": [
        "Preserve exact replay, workflow correlation and artifact download behavior."
      ]
    },
    {
      "id": "swarm_workspace_or_artifact_change",
      "label": "Swarm Workspace Or Artifact Change",
      "read_agents": [
        "AGENTS.md",
        "scripts/AGENTS.md"
      ],
      "read_docs": [
        "docs/swarm-runtime.md",
        "docs/commit-policy.md"
      ],
      "read_code": [
        "scripts/agents/workspace.py",
        "scripts/agents/runtime_trace.py",
        "scripts/agents/lifecycle/status.py",
        "scripts/agents/lifecycle/request_approval.py"
      ],
      "check_tests": [
        "test/scripts/test_workspace_isolation.py",
        "test/scripts/test_swarm_cli_smoke.py"
      ],
      "notes": [
        "Preserve branch intent, trace artifacts and human-readable bundle views."
      ]
    },
    {
      "id": "swarm_policy_or_planning_change",
      "label": "Swarm Policy Or Planning Change",
      "read_agents": [
        "AGENTS.md",
        "scripts/AGENTS.md"
      ],
      "read_docs": [
        "docs/swarm-runtime.md",
        "docs/swarm-usage.md",
        "docs/agent-context-map.md",
        "docs/agent-task-classifier.json",
        "docs/verification-profiles.json",
        "docs/exec-plans/tech-debt-tracker.md"
      ],
      "read_code": [
        "scripts/agents/routing/",
        "scripts/agents/knowledge.py"
      ],
      "check_tests": [
        "test/scripts/test_swarm_cli_smoke.py"
      ],
      "notes": [
        "Keep routing policy, planning heuristics and verification profiles synchronized."
      ]
    },
    {
      "id": "bot_command_change",
      "label": "Bot Command Change",
      "read_agents": [
        "AGENTS.md",
        "src/bot/AGENTS.md"
      ],
      "read_docs": [
        "ARCHITECTURE.md",
        "docs/PRODUCT_SENSE.md"
      ],
      "read_code": [
        "src/bot/commands/",
        "src/middlewares/bot_enabled.py",
        "src/middlewares/db/processing/bot_settings_processor.py"
      ],
      "check_tests": [
        "test/bot/processing/"
      ],
      "notes": [
        "Read bot_settings_processor.py only if the command affects chat state or settings."
      ]
    },
    {
      "id": "media_routing_bugfix",
      "label": "Media Routing Bugfix",
      "read_agents": [
        "AGENTS.md",
        "src/bot/AGENTS.md",
        "src/bot/processing/AGENTS.md",
        "src/handlers/AGENTS.md"
      ],
      "read_docs": [
        "ARCHITECTURE.md",
        "docs/RELIABILITY.md",
        "docs/design-docs/runtime-pipeline.md",
        "docs/exec-plans/tech-debt-tracker.md"
      ],
      "read_code": [
        "src/bot/processing/media_router.py",
        "src/bot/processing/media_processor.py",
        "src/bot/processing/link_extractor.py",
        "src/utils/messages.py"
      ],
      "check_tests": [
        "test/bot/processing/test_media_router_multi_link.py",
        "test/bot/processing/test_media_processor_errors.py",
        "test/handlers/test_cleanup_helpers.py"
      ]
    },
    {
      "id": "runtime_contract_or_registry_change",
      "label": "Runtime Contract Or Registry Change",
      "read_agents": [
        "AGENTS.md",
        "src/handlers/AGENTS.md",
        "src/bot/AGENTS.md",
        "src/bot/processing/AGENTS.md"
      ],
      "read_docs": [
        "ARCHITECTURE.md",
        "docs/design-docs/runtime-pipeline.md",
        "docs/RELIABILITY.md"
      ],
      "read_code": [
        "src/handlers/contracts.py",
        "src/handlers/registry.py",
        "src/handlers/manager.py",
        "src/bot/processing/media_processor.py",
        "src/bot/processing/senders/"
      ],
      "check_tests": [
        "test/bot/processing/",
        "test/handlers/test_cleanup_helpers.py",
        "test/handlers/<Source>/"
      ]
    },
    {
      "id": "deploy_or_infra_change",
      "label": "Deploy Or Infra Change",
      "read_agents": [
        "AGENTS.md",
        "scripts/AGENTS.md",
        "deploy/AGENTS.md",
        "test/docker/AGENTS.md"
      ],
      "read_docs": [
        "docs/SECURITY.md",
        "docs/RELIABILITY.md",
        "docs/design-docs/deploy-storage-layout.md"
      ],
      "read_code": [
        "deploy/",
        "test/docker/",
        ".github/workflows/",
        "src/config.py",
        "src/utils/runtime_storage.py"
      ],
      "check_tests": [
        "isolated-or-manual-infra-checks"
      ],
      "notes": [
        "Runtime-sensitive checks require explicit user approval."
      ]
    },
    {
      "id": "docs_only_change",
      "label": "Docs-Only Change",
      "read_agents": [
        "AGENTS.md"
      ],
      "read_docs": [
        "tracked-docs-relevant-to-scope"
      ],
      "read_code": [
        "only-the-code-needed-to-verify-behavior"
      ],
      "check_tests": [],
      "notes": [
        "Tests are usually not required.",
        "At minimum, verify that the docs do not diverge from code."
      ]
    }
  ],
  "context_expansion_rules": {
    "allowed_when": [
      "task-specific code directly calls a neighboring module",
      "a test failure points to a neighboring subsystem",
      "a local AGENTS.md explicitly routes to a neighboring zone",
      "the task changes a contract, registry, artifact schema, or shared helper"
    ],
    "avoid_by_default": [
      "src/",
      "scripts/",
      "test/",
      "legacy-archive-materials",
      "unrelated source folders inside src/handlers/resources/"
    ]
  },
  "default_escalation_cases": [
    "the task changes typed contracts, approval boundaries or artifact schema",
    "the patch spreads from one contour into another contour",
    "the task changes bot orchestration, swarm lifecycle and sandbox behavior in one increment",
    "validation requires cookies, secrets, network, or isolated execution"
  ]
}
