{
  "version": 1,
  "description": "Machine-readable task classifier config for mapping prompts and changed areas to routing ids.",
  "routing_source": "docs/agent-task-routing.json",
  "default_task_type": "docs_only_change",
  "manual_review_task_type": "swarm_runtime_orchestration_change",
  "precedence": [
    "swarm_sandbox_or_remote_execution_change",
    "swarm_runtime_orchestration_change",
    "swarm_workspace_or_artifact_change",
    "swarm_policy_or_planning_change",
    "runtime_contract_or_registry_change",
    "deploy_or_infra_change",
    "media_routing_bugfix",
    "bot_command_change",
    "docs_only_change"
  ],
  "global_signals": {
    "docs_only_paths": [
      "README.md",
      "AGENTS.md",
      "ARCHITECTURE.md",
      "docs/"
    ],
    "code_paths": [
      "src/",
      "deploy/",
      "scripts/",
      "test/",
      ".github/workflows/",
      ".vscode/"
    ],
    "high_risk_keywords": [
      "contract",
      "registry",
      "runtime boundary",
      "schema",
      "migration",
      "push",
      "release",
      "deploy",
      "infra",
      "dispatcher",
      "supervisor",
      "sandbox",
      "github actions",
      "approval",
      "artifact"
    ]
  },
  "task_types": [
    {
      "id": "swarm_runtime_orchestration_change",
      "description_ru": "Изменения dispatcher, supervisor, lifecycle orchestration и MCP/CLI front door.",
      "match": {
        "prompt_keywords_any": [
          "dispatcher",
          "supervisor",
          "autonomous cycle",
          "approval boundary",
          "orchestration",
          "mcp",
          "run bundle",
          "оркестра",
          "супервиз",
          "апрув"
        ],
        "path_prefixes_any": [
          "scripts/agents/mcp/",
          "scripts/agents/lifecycle/"
        ],
        "file_names_any": [
          "cli.py",
          "dispatcher.py",
          "executor.py",
          "approve.py",
          "request_approval.py",
          "status.py"
        ]
      }
    },
    {
      "id": "swarm_sandbox_or_remote_execution_change",
      "description_ru": "Изменения sandbox adapters, Docker flow и GitHub Actions remote execution.",
      "match": {
        "prompt_keywords_any": [
          "sandbox",
          "docker",
          "github actions",
          "workflow",
          "remote execution",
          "artifact download",
          "gha",
          "контейнер",
          "воркфлоу",
          "удаленн"
        ],
        "path_prefixes_any": [
          "test/docker/",
          ".github/workflows/"
        ],
        "file_names_any": [
          "sandbox_adapters.py",
          "swarm-sandbox.yml",
          "Dockerfile",
          "Dockerfile.dockerignore"
        ]
      }
    },
    {
      "id": "swarm_workspace_or_artifact_change",
      "description_ru": "Изменения isolated workspace, runtime trace, run artifacts и human-readable views.",
      "match": {
        "prompt_keywords_any": [
          "workspace",
          "artifact",
          "context trace",
          "branch intent",
          "diff preview",
          "job queue",
          "run status",
          "артефакт",
          "воркспейс",
          "трейс"
        ],
        "path_prefixes_any": [
          "runs/"
        ],
        "file_names_any": [
          "workspace.py",
          "runtime_trace.py",
          "status.py",
          "request_approval.py"
        ]
      }
    },
    {
      "id": "swarm_policy_or_planning_change",
      "description_ru": "Изменения routing policy, planning knowledge и verification profiles для swarm contour.",
      "match": {
        "prompt_keywords_any": [
          "routing",
          "verification profile",
          "classifier",
          "planning",
          "context map",
          "task type",
          "policy",
          "маршрутизац",
          "классифик",
          "профил"
        ],
        "path_prefixes_any": [
          "docs/exec-plans/",
          "scripts/agents/routing/"
        ],
        "file_names_any": [
          "agent-context-map.md",
          "agent-task-classifier.json",
          "agent-task-routing.json",
          "verification-profiles.json",
          "knowledge.py",
          "plan.py",
          "route.py"
        ]
      }
    },
    {
      "id": "bot_command_change",
      "description_ru": "Изменения команд бота и chat-control поведения.",
      "match": {
        "prompt_keywords_any": [
          "/help",
          "/info",
          "/statistics",
          "/start",
          "/stop",
          "/toggle_bot",
          "/toggle_errors",
          "/toggle_notifications",
          "bot command",
          "команд",
          "toggle"
        ],
        "path_prefixes_any": [
          "src/bot/commands/"
        ],
        "file_names_any": [
          "help.py",
          "info.py",
          "statistics.py",
          "toggle_bot.py",
          "toggle_errors.py",
          "toggle_notifications.py"
        ]
      }
    },
    {
      "id": "media_routing_bugfix",
      "description_ru": "Ошибки в routing и orchestration обработки ссылок.",
      "match": {
        "prompt_keywords_any": [
          "media router",
          "routing",
          "resolve_url",
          "multi-link",
          "caption",
          "unsupported",
          "block outcome",
          "router",
          "ссылк",
          "маршрутиз",
          "обработк"
        ],
        "path_prefixes_any": [
          "src/bot/processing/"
        ],
        "file_names_any": [
          "media_router.py",
          "media_processor.py",
          "link_extractor.py",
          "messages.py"
        ]
      }
    },
    {
      "id": "runtime_contract_or_registry_change",
      "description_ru": "Изменения typed contract, registry, sender dispatch или runtime boundary.",
      "match": {
        "prompt_keywords_any": [
          "contract",
          "registry",
          "content type",
          "contenttype",
          "mediaresult",
          "sender registry",
          "runtime boundary",
          "typed",
          "контракт",
          "реестр",
          "границ"
        ],
        "path_prefixes_any": [
          "src/handlers/",
          "src/bot/processing/senders/"
        ],
        "file_names_any": [
          "contracts.py",
          "registry.py",
          "manager.py",
          "media_processor.py"
        ]
      }
    },
    {
      "id": "deploy_or_infra_change",
      "description_ru": "Изменения деплоя, workflows, runtime storage и инфраструктуры.",
      "match": {
        "prompt_keywords_any": [
          "deploy",
          "docker",
          "workflow",
          "github actions",
          "infra",
          "runtime storage",
          "cookies sync",
          "деплой",
          "инфра"
        ],
        "path_prefixes_any": [
          "deploy/",
          ".github/workflows/",
          "scripts/"
        ],
        "file_names_any": [
          "Dockerfile",
          "manager.sh",
          "runtime_storage.py",
          "deploy-dev.yml",
          "deploy-prod.yml"
        ]
      }
    },
    {
      "id": "docs_only_change",
      "description_ru": "Изменения только в документации без кодового scope.",
      "match": {
        "path_prefixes_any": [
          "docs/"
        ],
        "file_names_any": [
          "README.md",
          "AGENTS.md",
          "ARCHITECTURE.md"
        ]
      },
      "heuristics": {
        "prefer_when_all_changed_paths_match": [
          "README.md",
          "AGENTS.md",
          "ARCHITECTURE.md",
          "docs/"
        ]
      }
    }
  ],
  "tie_break_rules": [
    {
      "when_ids_overlap": [
        "swarm_sandbox_or_remote_execution_change",
        "deploy_or_infra_change"
      ],
      "prefer": "swarm_sandbox_or_remote_execution_change",
      "reason": "Swarm sandbox changes should not collapse into generic deploy/infra routing."
    },
    {
      "when_ids_overlap": [
        "swarm_runtime_orchestration_change",
        "swarm_workspace_or_artifact_change"
      ],
      "prefer": "swarm_runtime_orchestration_change",
      "reason": "Lifecycle and dispatcher changes have broader orchestration impact than artifact-only changes."
    },
    {
      "when_ids_overlap": [
        "docs_only_change",
        "swarm_policy_or_planning_change"
      ],
      "prefer": "swarm_policy_or_planning_change",
      "reason": "Routing and verification policy changes should not collapse into plain docs-only work."
    }
  ],
  "manual_review_cases": [
    "Multiple high-risk task types match with similar confidence.",
    "The task touches both swarm orchestration and sandbox execution.",
    "The task changes approval boundaries, push behavior or remote execution contracts.",
    "The task requests push, release or other irreversible actions."
  ]
}
